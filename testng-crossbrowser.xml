<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Optional suite demonstrating parallel="tests": the same LoginTest class runs
  concurrently on two different browsers, each <test> block getting its own
  thread and its own "browser" parameter (picked up by BaseTest.setUp).
  Run with: mvn test -Dsuite.file=testng-crossbrowser.xml
-->
<suite name="SauceDemo Cross-Browser Suite" verbose="1" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

</suite>
